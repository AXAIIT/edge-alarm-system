{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alarm_system_raw_schema.json",
  "title": "Project 08 Alarm System Per-Event Raw Result",
  "type": "object",
  "description": "One row is one event_id and one alarm generation record. Summary metrics such as p50/p90/p95/p99, schema pass rate, average FPS, and total event_count belong to processed results.",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "schema_version",
    "project",
    "measurement_granularity",
    "board",
    "target",
    "environment_baseline_id",
    "event_id",
    "alarm_domain",
    "alarm_type",
    "event_stage",
    "route_target",
    "route_reason",
    "needs_text",
    "needs_vlm",
    "text_purpose",
    "vlm_purpose",
    "evidence_hash",
    "route_decision",
    "input_source_id",
    "frame_id",
    "model_combo_id",
    "detector_backend",
    "detector_artifact_sha256",
    "detector_precision",
    "llm_model",
    "vlm_model",
    "video_model",
    "project08_model_refs",
    "detection_latency_ms",
    "event_trigger_latency_ms",
    "roi_crop_latency_ms",
    "video_clip_latency_ms",
    "vlm_total_ms",
    "video_understanding_total_ms",
    "llm_first_token_ms",
    "llm_decode_tokens_per_s",
    "llm_total_ms",
    "json_schema_pass",
    "json_fact_conflict",
    "json_repair_count",
    "end_to_end_alarm_ms",
    "memory_peak_mb",
    "swap_used_mb",
    "temperature_max_c",
    "power_w",
    "power_mode",
    "cpu_gpu_npu_bpu_utilization",
    "queue_depth_max",
    "drop_count",
    "fallback_status",
    "status",
    "raw_event_path",
    "alarm_json_path",
    "runtime_log_path",
    "monitor_log_path",
    "failure_log_path",
    "related_troubleshooting_id"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "timestamp": {"type": "string"},
    "schema_version": {"type": "integer", "const": 1},
    "project": {"type": "string", "const": "08_alarm_system"},
    "measurement_granularity": {"type": "string", "const": "per_event"},
    "board": {"type": "string"},
    "target": {"type": "string", "enum": ["jetson_8gb", "rk3588_8gb", "pc"]},
    "environment_baseline_id": {"type": "string"},
    "event_id": {"type": "string"},
    "alarm_domain": {
      "type": "string",
      "enum": [
        "visual_detection",
        "visual_evidence",
        "text_explanation",
        "system_runtime",
        "model_runtime",
        "json_quality",
        "video_fallback"
      ]
    },
    "alarm_type": {
      "type": "string",
      "enum": [
        "person_presence",
        "vehicle_presence",
        "multi_object_scene",
        "roi_object_review",
        "visual_abnormal_review",
        "device_panel_state_review",
        "detection_json_summary",
        "alarm_reasoning",
        "alarm_json_generation",
        "pipeline_runtime_fault",
        "model_runtime_fault",
        "json_fact_conflict",
        "video_summary_disabled",
        "generic_object_event"
      ]
    },
    "event_stage": {"type": "string", "enum": ["candidate", "verified", "rejected", "fallback"]},
    "route_target": {"type": "string", "enum": ["rule_only", "template_only", "text_only", "vlm_only", "text_then_vlm", "vlm_then_text"]},
    "route_reason": {"type": ["string", "null"]},
    "needs_text": {"type": "boolean"},
    "needs_vlm": {"type": "boolean"},
    "text_purpose": {"type": ["string", "null"]},
    "vlm_purpose": {"type": ["string", "null"]},
    "evidence_hash": {"type": ["string", "null"]},
    "route_decision": {"type": "object", "additionalProperties": true},
    "input_source_id": {"type": "string"},
    "frame_id": {"type": ["string", "integer"]},
    "model_combo_id": {"type": "string"},
    "detector_backend": {"type": "string"},
    "detector_artifact_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
    "detector_precision": {"type": ["string", "null"]},
    "llm_model": {"type": ["string", "null"]},
    "vlm_model": {"type": ["string", "null"]},
    "video_model": {"type": ["string", "null"]},
    "project08_model_refs": {"type": "array", "items": {"type": "string"}},
    "detection_latency_ms": {"type": ["number", "null"]},
    "event_trigger_latency_ms": {"type": ["number", "null"]},
    "roi_crop_latency_ms": {"type": ["number", "null"]},
    "video_clip_latency_ms": {"type": ["number", "null"]},
    "vlm_total_ms": {"type": ["number", "null"]},
    "video_understanding_total_ms": {"type": ["number", "null"]},
    "llm_first_token_ms": {"type": ["number", "null"]},
    "llm_decode_tokens_per_s": {"type": ["number", "null"]},
    "llm_total_ms": {"type": ["number", "null"]},
    "json_schema_pass": {"type": "boolean"},
    "json_fact_conflict": {"type": "boolean"},
    "json_repair_count": {"type": "integer", "minimum": 0},
    "end_to_end_alarm_ms": {"type": ["number", "null"]},
    "memory_peak_mb": {"type": ["number", "null"]},
    "swap_used_mb": {"type": ["number", "null"]},
    "temperature_max_c": {"type": ["number", "null"]},
    "power_w": {"type": ["number", "null"]},
    "power_mode": {"type": ["string", "null"]},
    "cpu_gpu_npu_bpu_utilization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_peak": {"type": ["number", "null"]},
        "gpu_peak": {"type": ["number", "null"]},
        "npu_peak": {"type": ["number", "null"]},
        "bpu_peak": {"type": ["number", "null"]},
        "unavailable_metrics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "queue_depth_max": {"type": ["integer", "null"]},
    "drop_count": {"type": "integer", "minimum": 0},
    "fallback_status": {"$ref": "#/$defs/fallback_status"},
    "status": {"type": "string", "enum": ["pass", "functional_pass", "pending_evidence_registration", "fail", "degraded", "blocked", "not_executed", "not_verified", "mock", "stub"]},
    "raw_event_path": {"type": ["string", "null"]},
    "alarm_json_path": {"type": ["string", "null"]},
    "runtime_log_path": {"type": ["string", "null"]},
    "monitor_log_path": {"type": ["string", "null"]},
    "failure_log_path": {"type": ["string", "null"]},
    "related_troubleshooting_id": {"type": ["string", "null"]}
  },
  "$defs": {
    "fallback_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detector", "event_trigger", "vlm", "video", "llm", "alarm_json"],
      "properties": {
        "detector": {"type": "string", "enum": ["ok", "failed", "fallback", "not_executed"]},
        "event_trigger": {"type": "string", "enum": ["ok", "failed", "fallback", "not_executed"]},
        "vlm": {"type": "string", "enum": ["ok", "timeout", "disabled_by_project08_scope", "not_executed", "failed"]},
        "video": {"type": "string", "enum": ["ok", "timeout", "disabled_by_project08_scope", "not_executed", "failed"]},
        "llm": {"type": "string", "enum": ["ok", "timeout", "template_fallback", "failed", "not_executed"]},
        "alarm_json": {"type": "string", "enum": ["ok", "schema_repaired", "fact_conflict_detected", "failed", "not_executed"]}
      }
    }
  }
}
